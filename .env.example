# Optional environment for speak.py / narrate.py.
# Copy to .env and load it with:  set -a; source .env; set +a
# Both scripts work without it.

# Let ops that Apple's MPS backend lacks fall back to CPU.
# speak.py and narrate.py already set this themselves; it's here for your own scripts.
PYTORCH_ENABLE_MPS_FALLBACK=1

# Leave unset: the scripts go offline automatically once the model and voices
# are cached, and stay online to download them otherwise.
# Set to 0 to always check the Hugging Face Hub for updates.
# HF_HUB_OFFLINE=0
